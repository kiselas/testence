{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:testence:schema:release-manifest:1",
  "title": "Testence release decision manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target_version", "candidate", "artifacts", "gates", "decision", "rollback"],
  "properties": {
    "schema": {"const": "testence/release-manifest/1"},
    "target_version": {"type": "string", "minLength": 1},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "rc_sha", "tag", "dirty_worktree"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "rc_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "tag": {"type": ["string", "null"]},
        "dirty_worktree": {"type": "boolean"}
      }
    },
    "artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "gates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "status", "receipts", "missing"],
        "properties": {
          "id": {"type": "string", "pattern": "^G[1-8]$"},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "incomplete", "blocked"]},
          "receipts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "missing": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner", "reason"],
      "properties": {
        "status": {"enum": ["go", "no-go"]},
        "owner": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "rollback": {"type": "string", "minLength": 1}
  }
}
