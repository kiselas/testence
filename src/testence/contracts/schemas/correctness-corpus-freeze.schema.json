{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testence.dev/schemas/correctness-corpus-freeze.schema.json",
  "title": "Testence correctness corpus input freeze",
  "type": "object",
  "required": ["schema", "corpus_digest", "files"],
  "properties": {
    "schema": {"const": "testence/correctness-corpus-freeze/1"},
    "corpus_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
