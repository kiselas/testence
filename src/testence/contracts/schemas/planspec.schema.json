{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:testence:schema:planspec:2",
  "title": "Testence PlanSpec v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "project_id", "id", "title", "claims", "assertions", "scenarios"],
  "properties": {
    "schema": {"const": "testence/planspec/2"},
    "project_id": {"$ref": "#/$defs/id"},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "source": {"type": "string", "minLength": 1, "maxLength": 500},
    "owner": {"type": "string", "minLength": 1, "maxLength": 200},
    "requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/traceLink"}
    },
    "issues": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/traceLink"}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assertion"}
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "traceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "url": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "oracles"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
        "oracles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["ui", "network", "api", "a11y", "visual", "custom"]
          }
        },
        "required": {"type": "boolean", "default": true}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim_id", "oracle"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "claim_id": {"$ref": "#/$defs/id"},
        "oracle": {"enum": ["ui", "network", "api", "a11y", "visual", "custom"]},
        "required": {"type": "boolean", "default": true},
        "expected": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "claims"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "risk": {"type": "string", "minLength": 1, "maxLength": 200},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "lifecycle", "session", "browser.navigation", "browser.dom",
              "browser.network", "browser.websocket", "visual.screenshot",
              "browser.accessibility", "browser.javascript", "browser.keyboard",
              "browser.frames", "browser.popups", "browser.files", "browser.dialogs",
              "browser.native", "browser.clock",
              "evidence"
            ]
          }
        }
      }
    }
  }
}
