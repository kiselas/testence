{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:testence:schema:planspec:1",
  "title": "Testence PlanSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "claims", "scenarios"],
  "properties": {
    "schema": {"const": "testence/planspec/1"},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "source": {"type": "string", "minLength": 1, "maxLength": 500},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "oracles"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
        "oracles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["ui", "network", "api", "a11y", "visual", "custom"]
          }
        },
        "required": {"type": "boolean", "default": true}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "claims"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "risk": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  }
}
