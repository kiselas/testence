{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testence.dev/schemas/acceptance-receipt.schema.json",
  "title": "Testence acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "task_ids", "check_ids", "profile", "evidence_kind", "producer",
    "source", "subjects", "environment", "command", "expected", "observed",
    "status", "skipped", "limitations", "artifacts", "review"
  ],
  "properties": {
    "schema": {"const": "testence/acceptance-receipt/1"},
    "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^S3-[0-9]{2}$"}},
    "check_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"}},
    "profile": {"enum": ["local", "rc", "external"]},
    "evidence_kind": {"enum": ["unit", "negative_probe", "consumer", "hosted_ci", "external_review", "pilot"]},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "version", "runner"],
      "properties": {"tool": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "runner": {"type": "string", "minLength": 1}}
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_sha", "dirty", "materialized_digest"],
      "properties": {
        "candidate_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"},
        "materialized_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "subjects": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "environment": {"type": "object"},
    "command": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["argv", "cwd_profile", "started_at", "finished_at", "exit_code"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cwd_profile": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"},
        "finished_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"},
        "exit_code": {"type": "integer"}
      }
    },
    "expected": {"type": "object"},
    "observed": {"type": "object"},
    "status": {"enum": ["passed", "failed", "incomplete"]},
    "skipped": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "reason"], "properties": {"id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "review": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["reviewer", "scope_digest", "decision", "reference", "reviewed_at"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "scope_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "decision": {"enum": ["accepted", "rejected", "incomplete"]},
        "reference": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"}
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
