{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:testence:schema:delivery-receipt:1",
  "title": "Testence delivery receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "project_id", "launch_id", "job_run_id", "artifacts_digest", "idempotency_key", "outcome", "attempts"],
  "properties": {
    "schema": {"const": "testence/delivery-receipt/1"},
    "run_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "launch_id": {"type": "string", "minLength": 1},
    "job_run_id": {"type": "string", "minLength": 1},
    "artifacts_digest": {"$ref": "#/$defs/digest"},
    "idempotency_key": {"$ref": "#/$defs/digest"},
    "outcome": {"enum": ["delivered", "failed"]},
    "attempts": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["number", "outcome", "exit_code", "duration_ms"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "outcome": {"enum": ["delivered", "failed", "timeout", "error"]},
          "exit_code": {"type": ["integer", "null"]},
          "duration_ms": {"type": "number", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
