{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:testence:schema:verdict-submission:1",
  "title": "Testence verdict submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "run_id", "case_id", "attempt_id", "proof_id", "verdict_digest", "output"],
  "properties": {
    "schema": {"const": "testence/verdict-submission/1"},
    "project_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "proof_id": {"type": "string", "minLength": 1},
    "verdict_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "output": {"type": "string", "minLength": 1}
  }
}
