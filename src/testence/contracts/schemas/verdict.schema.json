{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:testence:schema:verdict:2",
  "title": "Testence Verdict v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "project_id",
    "case_id",
    "variant_id",
    "attempt_id",
    "run_id",
    "proof_id",
    "plan_digest",
    "test_digest",
    "policy_digest",
    "pack_digest",
    "plan_id",
    "test_id",
    "verdict",
    "confidence",
    "summary",
    "claim_results"
  ],
  "properties": {
    "schema": {"const": "testence/verdict/2"},
    "project_id": {"$ref": "#/$defs/id"},
    "case_id": {"$ref": "#/$defs/id"},
    "variant_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "proof_id": {"$ref": "#/$defs/id"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "test_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "pack_digest": {"$ref": "#/$defs/digest"},
    "plan_id": {"$ref": "#/$defs/id"},
    "test_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "verdict": {
      "type": ["string", "null"],
      "enum": [
        "real_bug",
        "test_bug",
        "behaviour_change",
        "ui_change",
        "flaky_timing",
        "environment",
        null
      ]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "blocked_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claimResult"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": null}}},
      "then": {"required": ["blocked_on"], "properties": {"blocked_on": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"verdict": {"const": "test_bug"}}},
      "then": {
        "properties": {
          "claim_results": {"contains": {"properties": {"status": {"const": "passed"}}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": ["real_bug", "behaviour_change", "ui_change", "flaky_timing", "environment"]
          }
        }
      },
      "then": {
        "properties": {
          "claim_results": {
            "contains": {"properties": {"status": {"enum": ["failed", "blocked"]}}}
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "claimResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "status", "reason", "evidence"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["passed", "failed", "blocked", "not_evaluated"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["passed", "failed"]}}},
          "then": {"properties": {"evidence": {"minItems": 1}}}
        }
      ]
    }
  }
}
