{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:testence:schema:ci-receipt:1",
  "title": "Testence CI receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "project_id", "run_status", "test", "quality", "delivery", "final_exit"],
  "properties": {
    "schema": {"const": "testence/ci-receipt/1"},
    "run_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "run_status": {"type": "string", "minLength": 1},
    "test": {"$ref": "#/$defs/outcome"},
    "quality": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "exit_code", "errors"],
      "properties": {
        "mode": {"enum": ["execution", "assurance", "proven"]},
        "exit_code": {"type": "integer"},
        "errors": {"type": "array", "items": {"type": "string"}},
        "testplan_unresolved": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {"id": {"type": "string"}, "selector": {"type": "string"}}
          }
        },
        "flaky": {"type": "array", "items": {"type": "string"}},
        "negative_proof": {"$ref": "#/$defs/negative_proof"}
      }
    },
    "delivery": {
      "type": "object",
      "required": ["outcome", "exit_code"],
      "properties": {
        "outcome": {"type": "string"},
        "exit_code": {"type": "integer"},
        "receipt": {"type": "string"}
      }
    },
    "final_exit": {"type": "integer"}
  },
  "$defs": {
    "proof_outcome": {
      "enum": ["proven", "stayed_green", "wrong_reason", "inconclusive", "stale", "no_control"]
    },
    "negative_proof": {
      "type": "object", "additionalProperties": false,
      "required": ["runs", "claims", "counts"],
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["run_id", "control"],
            "properties": {
              "run_id": {"type": "string"},
              "control": {"type": ["string", "null"]}
            }
          }
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["run_id", "control", "failed_claims"],
            "properties": {
              "run_id": {"type": "string"},
              "control": {"type": "string"},
              "failed_claims": {"type": "integer", "minimum": 0},
              "collateral_claims": {"type": "array", "items": {"type": "string"}},
              "collateral_share": {"type": "number", "minimum": 0, "maximum": 1},
              "blunt": {"type": "boolean"}
            }
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["outcome", "evidence"],
            "properties": {
              "outcome": {"$ref": "#/$defs/proof_outcome"},
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["outcome", "reason", "test", "run_id", "control"],
                  "properties": {
                    "outcome": {"$ref": "#/$defs/proof_outcome"},
                    "reason": {"type": "string"},
                    "test": {"type": "string"},
                    "run_id": {"type": "string"},
                    "control": {"type": "string"},
                    "collateral_claims": {"type": "array", "items": {"type": "string"}}
                  }
                }
              }
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["exit_code"],
      "properties": {"exit_code": {"type": "integer"}}
    }
  }
}
