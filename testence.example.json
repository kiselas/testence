{
  "_comment": [
    "Copy to testence.json (or testence.toml on Python 3.11+). Tracked in the",
    "project's repo: it describes environments, never credentials.",
    "Credentials belong in .env.local or the real environment.",
    "Select an environment with TESTENCE_PROFILE or --testence-profile."
  ],
  "api_prefix": "/api/",
  "timeout_ms": 10000,
  "browser_channel": "chromium",
  "profiles": {
    "local": {
      "base_url": "http://localhost:4200",
      "auth": "api-session",
      "api_login_path": "/api/v1/auth/login"
    },
    "staging": {
      "base_url": "https://staging.example.com",
      "auth": "form",
      "login_path": "/login",
      "verify_tls": false,
      "session_cookie": "session_id"
    },
    "staging-attached": {
      "base_url": "https://staging.example.com",
      "auth": "attached",
      "cdp_url": "http://127.0.0.1:9222",
      "session_cookie": "session_id"
    },
    "ci": {
      "base_url": "http://app:8000",
      "auth": "api-session",
      "headed": true,
      "runs_root": "artifacts/runs"
    }
  }
}
