# Copy to .env.local (git-ignored) and fill in. Never commit real values.
#
# Target ---------------------------------------------------------------------
TESTENCE_BASE_URL=https://app-under-test.example.com
TESTENCE_API_PREFIX=/api/

# Auth ----------------------------------------------------------------------
# none | form | api-session | bearer | basic | attached
TESTENCE_AUTH=form
TESTENCE_LOGIN_PATH=/login
# TESTENCE_API_LOGIN_PATH=/api/v1/auth/login
TESTENCE_USER=user@example.com
TESTENCE_PASSWORD=replace-me

# Browser -------------------------------------------------------------------
TESTENCE_HEADED=true
# Attach to a Chrome you already logged into (pairs with TESTENCE_AUTH=attached):
# TESTENCE_CDP_URL=http://127.0.0.1:9222

# TLS -----------------------------------------------------------------------
# Self-hosted environments may use a private CA that the browser trusts through
# the system store but Python does not. Prefer naming the CA over disabling TLS.
# TESTENCE_CA_BUNDLE=C:/certs/testing-root.pem
TESTENCE_VERIFY_TLS=true

# Misc ----------------------------------------------------------------------
TESTENCE_TIMEOUT_MS=10000
TESTENCE_RUNS_ROOT=runs
# TESTENCE_PROFILE=staging
